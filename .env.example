# ==========================================
# LOCALSTACK CONFIGURATION
# ==========================================
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Credentials dummy
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Para que boto3 apunte a LocalStack automáticamente
AWS_ENDPOINT_URL=http://localhost:4566

# ==========================================
# APPLICATION SETTINGS
# ==========================================
ENVIRONMENT=local  # local | dev | prod
LOG_LEVEL=INFO     # DEBUG | INFO | WARNING | ERROR

# DynamoDB
DYNAMODB_TABLE_NAME=TodoTable

# Cognito
COGNITO_USER_POOL_ID=<deploy-will-set>
COGNITO_CLIENT_ID=<deploy-will-set>

# API Gateway
API_GATEWAY_URL=<deploy-will-set>

# ==========================================
# LAMBDA POWERTOOLS
# ==========================================
POWERTOOLS_SERVICE_NAME=todo-api
POWERTOOLS_LOG_LEVEL=INFO
POWERTOOLS_METRICS_NAMESPACE=TodoApp
POWERTOOLS_TRACER_CAPTURE_RESPONSE=true
POWERTOOLS_TRACER_CAPTURE_ERROR=true

# Desactivar X-Ray en local
AWS_XRAY_SDK_ENABLED=false
POWERTOOLS_TRACE_DISABLED=true

# ==========================================
# CDK CONFIGURATION
# ==========================================
CDK_DEFAULT_ACCOUNT=000000000000  # Account ID dummy para LocalStack
CDK_DEFAULT_REGION=us-east-1
